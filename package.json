{
  "name": "curb",
  "private": true,
  "version": "0.0.1",
  "description": "Curb \u2014 control plane keamanan untuk AI agent (cost/loop breaker + guardrail)",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",

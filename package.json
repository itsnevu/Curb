    "down": "docker compose down",
    "demo": "tsx scripts/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}

# --- Curb env ---
# Project API key. Required: agents send it as x-curb-key, and it decides which
# project their traffic belongs to. The gateway refuses to start without it.
CURB_API_KEY=dev-key-change-me
# Which project the gateway's own key maps to.
CURB_PROJECT_ID=default
CURB_ORG_ID=default

# Data. Leave empty to run everything in memory (fine for trying it out).
DATABASE_URL=postgresql://curb:curb@localhost:5432/curb
REDIS_URL=redis://localhost:6379

# Gateway
GATEWAY_PORT=8080
OPENAI_UPSTREAM=https://api.openai.com
ANTHROPIC_UPSTREAM=https://api.anthropic.com
# Max request body in bytes. LLM requests carry whole conversations — the default is 32 MB.
# CURB_BODY_LIMIT_BYTES=33554432
# Run the gateway with NO authentication. Local development only.
# CURB_ALLOW_ANONYMOUS=1
# Override model pricing (JSON, USD per 1M tokens), optional:
# CURB_PRICING={"gpt-4o":{"in":2.5,"out":10}}

# Control plane
CONTROL_PLANE_PORT=8090
CONTROL_PLANE_URL=http://localhost:8090

# Fail mode when the engine or its dependencies are down:
# "closed" (stop — safe) or "open" (carry on).
CURB_FAIL_MODE=closed

# Optional alerts when a breaker trips or something is waiting for approval
# CURB_WEBHOOK_URL=https://example.dev/hook
# CURB_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# CURB_DASHBOARD_URL=http://localhost:8090

# Control-plane hardening
# Per-project request ceiling (0 disables)
CURB_RATE_LIMIT_PER_MINUTE=600
# How long an undecided approval stays actionable
CURB_APPROVAL_TTL_MS=3600000
# Let the gateway boot with no API key — LOCAL DEVELOPMENT ONLY
# CURB_ALLOW_ANONYMOUS=1

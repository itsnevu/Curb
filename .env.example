# --- Curb env ---
# Kunci API project. Wajib: dipakai gateway, SDK, dan dashboard.
CURB_API_KEY=dev-key-ganti-ini

# Data. Kalau dikosongkan, semuanya jalan di memori (cocok untuk mencoba).
DATABASE_URL=postgresql://curb:curb@localhost:5432/curb
REDIS_URL=redis://localhost:6379

# Gateway
GATEWAY_PORT=8080
OPENAI_UPSTREAM=https://api.openai.com
ANTHROPIC_UPSTREAM=https://api.anthropic.com
# Override harga model (JSON per 1 juta token), opsional:
# CURB_PRICING={"gpt-4o":{"in":2.5,"out":10}}

# Control plane
CONTROL_PLANE_PORT=8090
CONTROL_PLANE_URL=http://localhost:8090

# Fail mode kalau engine/deps down: "closed" (stop, aman) atau "open" (lanjut)
CURB_FAIL_MODE=closed

# Alert opsional saat breaker nyala / ada yang minta izin
# CURB_WEBHOOK_URL=https://contoh.dev/hook
# CURB_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# CURB_DASHBOARD_URL=http://localhost:8090

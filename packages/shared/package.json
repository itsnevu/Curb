{
  "name": "@curb/shared",
  "version": "0.1.0",
  "description": "Shared wire types, policy schemas, and argument redaction for Curb",
  "homepage": "https://github.com/itsnevu/Curb#readme",
  "bugs": "https://github.com/itsnevu/Curb/issues",
  "repository": { "type": "git", "url": "git+https://github.com/itsnevu/Curb.git", "directory": "packages/shared" },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "vitest": "^2.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}

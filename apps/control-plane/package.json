{
  "name": "@curb/control-plane",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/public dist/db && cp -R src/public/. dist/public/ && cp -R src/db/. dist/db/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@curb/policy-engine": "workspace:*",
    "@curb/shared": "workspace:*",
    "fastify": "^4.28.0",
    "ioredis": "^5.4.0",
    "pg": "^8.23.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "vitest": "^2.0.0",
    "@curb/sdk": "workspace:*"
  }
}
